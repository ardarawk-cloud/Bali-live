# OpenAI API key. Keep this file private on your PC.
OPENAI_API_KEY=

# Cost-sensitive model suitable for high-volume short LIVE replies.
OPENAI_MODEL=gpt-5.6-luna

# TikFinity Desktop Event API endpoint.
TIKFINITY_WS=ws://localhost:21213/

# Local overlay server.
PORT=8787

# Per-user AI command cooldown in seconds.
USER_COOLDOWN_SECONDS=30
